# Copy to .env and set your keys.
# This file is loaded by serve.py at startup.

GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_API_KEY
CESIUM_ION_TOKEN=PASTE_YOUR_CESIUM_ION_TOKEN
SIM_ORIGIN_LAT=34.0522
SIM_ORIGIN_LON=-118.2437
DRONE_MODEL_URI=/assets/models/drone/default_drone.glb

# Optional: if these are blank, server auto-picks the first .glb/.gltf in:
# assets/models/fire, assets/models/building, assets/models/park, assets/models/responder
# FIRE_MODEL_URI=
# BUILDING_MODEL_URI=
# PARK_MODEL_URI=
# RESPONDER_MODEL_URI=
